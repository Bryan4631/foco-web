# URL base de la API Rails (Tarea 1). Copia este archivo como `.env` y ajusta el valor.
# Expo solo expone al código las variables que empiezan con EXPO_PUBLIC_.
#
# Producción (apifoco.frubilarz.cl):
EXPO_PUBLIC_API_URL=https://apifoco.frubilarz.cl/api/v1
#
# Emulador Android con la API corriendo en tu PC (10.0.2.2 = tu PC visto desde el emulador):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
#
# Simulador iOS con la API en tu PC:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
